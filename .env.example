# Klyro environment defaults (all optional — most settings live in the app UI).
# These are read at runtime by the main process as fallbacks.

# Default provider: openai | anthropic | gemini | ollama | openai-compatible
KLYRO_PROVIDER=openai

# Optional base URL overrides
# KLYRO_OPENAI_BASE_URL=https://api.openai.com/v1
# KLYRO_OLLAMA_BASE_URL=http://localhost:11434

# Do NOT put API keys here. Set them in the app (Settings -> Providers);
# they are stored encrypted via the OS keychain (Electron safeStorage).
